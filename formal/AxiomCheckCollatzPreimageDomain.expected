Problems.Collatz.PreimageBarrier.small_orbits_bounded {n : ℕ} (hn : n < 4096) (k : ℕ) :
  Problems.Collatz.negT^[k] n < 2 ^ 19
Problems.Collatz.PreimageDomain.large_root_for_target {a : ℕ} (ha : 0 < a) (h3a : a % 3 ≠ 0) :
  ∃ r, 2 ^ 19 < r ∧ r % 3 = 1 ∧ Problems.Collatz.PreimageGrid.Nonperiodic r ∧ Reaches r a
Problems.Collatz.PreimageDomain.closed_domain_for_target {a : ℕ} (ha : 0 < a) (h3a : a % 3 ≠ 0) :
  ∃ r,
    Roots r r ∧
      Reaches r a ∧
        (∀ (n : ℕ), Roots r n → 4096 ≤ n ∧ Problems.Collatz.PreimageGrid.Nonperiodic n) ∧
          ∃ X₀, ∀ (X : ℕ), X₀ ≤ X → Problems.Collatz.PreimageGrid.count r X ≤ Problems.Collatz.PreimageGrid.count a X
