'Problems.Juggler.CollatzPadic.orbit_bridge' depends on axioms: [propext, Classical.choice, Quot.sound]
Problems.Juggler.CollatzPadic.orbit_bridge (n : ℕ) :
  ((PadicInt.toZModPow 1) (code n) = 0 ↔ n % 2 = 0) ∧
    code (Problems.Juggler.floorPower n) = minusStep (code n) ∧
      -code (Problems.Juggler.floorPower n) = plusStep (-code n) ∧
        (∀ (d : ℕ), code (Problems.Juggler.floorPower^[d] n) = minusStep^[d] (code n)) ∧
          (∀ (r d : ℕ),
              (PadicInt.toZModPow d) (code n) = -↑r ↔
                Problems.Juggler.itinerary n d = Problems.Juggler.CollatzBridge.parityWord r d) ∧
            ∀ (h : Problems.Juggler.ReachesOne n), ↑(code n) = ↑(Problems.Juggler.CollatzRational.terminatingCode n h)
