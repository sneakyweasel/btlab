Problems.Juggler.CollatzPadic.orbit_bridge (n : ℕ) :
  ((PadicInt.toZModPow 1) (code n) = 0 ↔ n % 2 = 0) ∧
    code (Problems.Juggler.floorPower n) = minusStep (code n) ∧
      -code (Problems.Juggler.floorPower n) = plusStep (-code n) ∧
        (∀ (d : ℕ), code (Problems.Juggler.floorPower^[d] n) = minusStep^[d] (code n)) ∧
          (∀ (r d : ℕ),
              (PadicInt.toZModPow d) (code n) = -↑r ↔
                Problems.Juggler.itinerary n d = Problems.Juggler.CollatzBridge.parityWord r d) ∧
            ∀ (h : Problems.Juggler.ReachesOne n), ↑(code n) = ↑(Problems.Juggler.CollatzRational.terminatingCode n h)
Problems.Juggler.CollatzPadic.periodic_bridge {n L : ℕ} (hL : 0 < L) (hcycle : Problems.Juggler.floorPower^[L] n = n) :
  Function.minimalPeriod minusStep (code n) = Function.minimalPeriod Problems.Juggler.floorPower n ∧
    Function.minimalPeriod plusStep (-code n) = Function.minimalPeriod Problems.Juggler.floorPower n ∧
      ↑(code n) = ↑↑(Problems.Juggler.CollatzBridge.wordConst (Problems.Juggler.itinerary n L)) / ↑↑(periodDenom n L) ∧
        ((∃ z, code n = ↑z) ↔
            periodDenom n L ∣ ↑(Problems.Juggler.CollatzBridge.wordConst (Problems.Juggler.itinerary n L))) ∧
          ∀ (z : ℤ),
            code n = ↑z →
              ∀ (d : ℕ),
                Problems.Juggler.CollatzBridge.shortcutZIter d (-z) = -z ↔ Problems.Juggler.floorPower^[d] n = n
