Problems.Juggler.CollatzRational.terminatingCode_semiconjugacy {n : ℕ} (h : Problems.Juggler.ReachesOne n) :
  terminatingCode (Problems.Juggler.floorPower n) ⋯ = minusStep (terminatingCode n h)
Problems.Juggler.CollatzRational.terminatingCode_plus_semiconjugacy {n : ℕ} (h : Problems.Juggler.ReachesOne n) :
  -terminatingCode (Problems.Juggler.floorPower n) ⋯ = plusStep (-terminatingCode n h)
