Problems.Collatz.PreimageScale.minus_scale_correction {a : ℕ} (ha : a % 3 = 1) (x : ℝ) :
  x / ↑(minusOddPreimage a) = x / ↑a * (3 / 2) / (1 + 1 / (2 * ↑a))
Problems.Collatz.PreimageScale.excluded_ancestor :
  minusOddPreimage 19 = 13 ∧
    Problems.Collatz.negT^[3] 104 = 13 ∧
      (∀ j ≤ 3, Problems.Collatz.negT^[j] 104 ≤ 104) ∧
        103 < 104 ∧ 4 * 19 ≤ 103 ∧ 104 ≤ 103 / 19 * (3 / 2) * ↑(minusOddPreimage 19)
Problems.Collatz.PreimageScale.finite_expanding_shift (F : Finset (List Bool)) (hF : ∀ w ∈ F, 1 < inverseFactor w) :
  ∃ K,
    1 ≤ K ∧
      ∀ (ws : List (List Bool)),
        (∀ w ∈ ws, w ∈ F) → ∀ (x : ℝ), inverseWord ws.flatten x + K ≤ inverseFactor ws.flatten * (x + K)
Problems.Collatz.PreimageScale.internal_prefix_height (F : Finset (List Bool)) {K : ℝ} (hK1 : 1 ≤ K)
  (hK : ∀ w ∈ F, inverseWord w 0 ≤ (inverseFactor w - 1) * K) (ws : List (List Bool)) (hws : ∀ w ∈ ws, w ∈ F)
  (u : List Bool) {L : ℕ} (hu : u.length ≤ L) {x : ℝ} (hx : 0 ≤ x) :
  inverseWord (ws.flatten ++ u) x + 1 ≤ 2 ^ L * inverseFactor ws.flatten * (x + K)
Problems.Collatz.PreimageScale.no_elementary_shift :
  ¬∃ K, (∀ (x : ℝ), 2 * x + K ≤ 2 * (x + K)) ∧ ∀ (x : ℝ), (2 * x + 1) / 3 + K ≤ 2 / 3 * (x + K)
