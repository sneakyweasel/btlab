'Problems.Collatz.PreimageGrid.nonperiodic_preimage' does not depend on any axioms
Problems.Collatz.PreimageGrid.count_odd {a t : ℕ} (ha : 4096 ≤ a) (h3 : a % 3 = 1) (hnp : Nonperiodic a) :
  count (4 * a) (cap t * (4 * a)) +
      count (Problems.Collatz.PreimageScale.minusOddPreimage a)
        (cap (t + 129) * Problems.Collatz.PreimageScale.minusOddPreimage a) ≤
    count a (cap (t + 100) * a)
Problems.Collatz.PreimageGrid.count_doubled_odd {a t : ℕ} (ha : 4096 ≤ a) (h3 : a % 3 = 1) (hnp : Nonperiodic a) :
  count (4 * a) (cap t * (4 * a)) +
      count (2 * Problems.Collatz.PreimageScale.minusOddPreimage a)
        (cap (t + 79) * (2 * Problems.Collatz.PreimageScale.minusOddPreimage a)) ≤
    count a (cap (t + 100) * a)
Problems.Collatz.PreimageGrid.measure_children {a : ℕ} (ha : 4096 ≤ a) (h3 : a % 3 = 1) (t : ℕ) :
  Problems.Collatz.PreimageGrid.measure t (4 * a) + 4 ≤ Problems.Collatz.PreimageGrid.measure (t + 100) a ∧
    Problems.Collatz.PreimageGrid.measure (t + 79) (2 * Problems.Collatz.PreimageScale.minusOddPreimage a) + 3 ≤
        Problems.Collatz.PreimageGrid.measure (t + 100) a ∧
      Problems.Collatz.PreimageGrid.measure (t + 129) (Problems.Collatz.PreimageScale.minusOddPreimage a) + 1 ≤
        Problems.Collatz.PreimageGrid.measure (t + 100) a
Problems.Collatz.PreimageGrid.fertile_children {a : ℕ} (ha : a % 3 = 1) :
  4 * a % 3 = 1 ∧
    (a % 9 = 1 → Problems.Collatz.PreimageScale.minusOddPreimage a % 3 = 1) ∧
      (a % 9 = 7 → 2 * Problems.Collatz.PreimageScale.minusOddPreimage a % 3 = 1) ∧
        (a % 9 = 4 → Problems.Collatz.PreimageScale.minusOddPreimage a % 3 = 0)
