'Problems.Collatz.BackwardMass.backward_mass_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
Problems.Collatz.BackwardMass.backward_mass_counterexample :
  ray.Infinite ∧
    (∀ (n : ℕ), Problems.Collatz.shortcutC n ∈ ray → n ∈ ray) ∧
      (∀ (n : ℕ), Problems.Collatz.negT n ∈ ray → n ∈ ray) ∧
        HasSum (fun k => 1 / (3 * 2 ^ k)) (2 / 3) ∧ ∀ (s : Finset ℕ), (∀ n ∈ s, n ∈ ray) → ∑ n ∈ s, 1 / ↑n ≤ 2 / 3
