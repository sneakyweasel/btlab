Problems.Juggler.CollatzMoments.coefficient_shift (w : List Problems.Juggler.Branch) (s : ℝ) :
  idealCoeff w * multiplier w ^ s = fairWeight w * multiplier w ^ (s - 1)
Problems.Juggler.CollatzMoments.complete_family_moment_loss :
  (∀ (u v : List Problems.Juggler.Branch),
      Problems.Juggler.PaperBCertificates.IsMinimalCertificate u →
        Problems.Juggler.PaperBCertificates.IsMinimalCertificate v → u <+: v → u = v) ∧
    HasSum certMass 1 ∧
      Summable tiltedCertMass ∧ ∑' (d : ℕ), tiltedCertMass d ≤ 3 / 4 ∧ ∑' (d : ℕ), tiltedCertMass d ≠ 1
