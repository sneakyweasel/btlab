Problems.Collatz.PreimageCertificate12.density_21_25 {a : ℕ} (ha : 0 < a) (ha3 : a % 3 ≠ 0) :
  ∃ X₀, ∀ (X : ℕ), X₀ ≤ X → X ^ 21 ≤ PreimageGrid.count a X ^ 25
Problems.Collatz.PreimageCertificate12.ancestor_density_21_25 {a : ℕ} (ha : 0 < a) (ha3 : a % 3 ≠ 0) :
  ∃ X₀, ∀ (X : ℕ), X₀ ≤ X → X ^ 21 ≤ PreimageDensity.ancestorCount a X ^ 25
